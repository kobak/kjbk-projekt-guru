<VirtualHost *:80>
    ServerName projekt.sajatdomain.hu
    Alias /.well-known/acme-challenge/ /var/lib/kozos-acme/.well-known/acme-challenge/
    <Directory /var/lib/kozos-acme/.well-known/acme-challenge/>
        Options None
        AllowOverride None
        Require all granted
    </Directory>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://projekt.sajatdomain.hu%{REQUEST_URI} [END,NE,R=301]
    ErrorLog ${APACHE_LOG_DIR}/kozos-error.log
    CustomLog ${APACHE_LOG_DIR}/kozos-access.log "%h %l %u %t \"%m %U %H\" %>s %b"
</VirtualHost>
