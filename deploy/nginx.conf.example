# Az aldomaint cseréld ki. A WordPress meglévő virtual hostjai mellé való.
server {
    listen 80;
    server_name projekt.sajatdomain.hu;
    client_max_body_size 26m;
    location / {
        proxy_pass http://127.0.0.1:8094;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
}
# HTTPS: certbot --nginx -d projekt.sajatdomain.hu
# A tanúsítvány kiadása után HTTP -> HTTPS átirányítást válassz.
