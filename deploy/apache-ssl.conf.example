<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName projekt.sajatdomain.hu
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/projekt.sajatdomain.hu/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/projekt.sajatdomain.hu/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
    ProxyRequests Off
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:8094/ connectiontimeout=5 timeout=90 retry=0
    ProxyPassReverse / http://127.0.0.1:8094/
    RequestHeader set X-Forwarded-Proto "https"
    LimitRequestBody 27262976
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
    ErrorLog ${APACHE_LOG_DIR}/kozos-error.log
    CustomLog ${APACHE_LOG_DIR}/kozos-access.log "%h %l %u %t \"%m %U %H\" %>s %b"
</VirtualHost>
</IfModule>
