# Ne másolj éles titkokat ide. A scripts/configure.py egyedi kulcsokat generál.
DEBUG=false
SECRET_KEY=GENERATE_WITH_CONFIGURE_SCRIPT
APP_URL=https://projekt.sajatdomain.hu
ALLOWED_HOSTS=projekt.sajatdomain.hu,localhost,127.0.0.1
POSTGRES_PASSWORD=GENERATE_WITH_CONFIGURE_SCRIPT
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sajatdomain.hu

# Brevo SMTP: a titkos kulcsot kizárólag a szerver .env fájljába írd.
# Csak hitelesített feladóval és sikeres próbaküldés után kapcsold be.
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=projekt guru <guru@sajatdomain.hu>
